PORT=5000
NODE_ENV=development

# Database Connection URLs (Supabase)
# DATABASE_URL: Pooled connection URL (Transaction mode via PgBouncer / Supavisor, port 6543) - used by app runtime
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: Direct connection URL (Session mode / direct DB connection, port 5432) - used by Prisma CLI for migrations
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000
AI_API_KEY=your_ai_api_key_here
AI_MODEL=gpt-4o-mini

